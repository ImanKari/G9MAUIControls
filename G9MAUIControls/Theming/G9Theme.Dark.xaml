<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="G9MAUIControls.Theming.G9ThemeDark">

    <!--
        G9 Design System — DARK
        Palette mirrors !TempData/G9DesignSystem.html (the design source of truth).
        Near-black warm Background (#0C0D0C) with raised Surface / CardBackground
        (#15171A) so cards lift off the page. Brand green brightens for dark contrast.
    -->

    <!-- ================= PRIMARY ================= -->
    <Color x:Key="Primary">#45A664</Color>
    <Color x:Key="OnPrimary">#062814</Color>
    <Color x:Key="PrimaryContainer">#173E25</Color>
    <Color x:Key="OnPrimaryContainer">#BDE5C9</Color>
    <Color x:Key="PrimaryBorder">#338E51</Color>
    <Color x:Key="PrimaryHover">#52B271</Color>
    <Color x:Key="PrimaryPressed">#338E51</Color>

    <!-- ================= SECONDARY (leaf accent) ================= -->
    <Color x:Key="Secondary">#6BBD5A</Color>
    <Color x:Key="OnSecondary">#0C2207</Color>
    <Color x:Key="SecondaryContainer">#1A3016</Color>
    <Color x:Key="OnSecondaryContainer">#C8E6BF</Color>
    <Color x:Key="SecondaryBorder">#2C4A23</Color>

    <!-- ================= TERTIARY (sky accent) ================= -->
    <Color x:Key="Tertiary">#6AAEE0</Color>
    <Color x:Key="OnTertiary">#04243F</Color>
    <Color x:Key="TertiaryContainer">#0E2540</Color>
    <Color x:Key="OnTertiaryContainer">#C2E0F7</Color>
    <Color x:Key="TertiaryBorder">#1E456B</Color>

    <!-- ================= QUATERNARY (violet accent) ================= -->
    <Color x:Key="Quaternary">#A78BD1</Color>
    <Color x:Key="OnQuaternary">#2A1B40</Color>
    <Color x:Key="QuaternaryContainer">#2E2340</Color>
    <Color x:Key="OnQuaternaryContainer">#E0D4F0</Color>
    <Color x:Key="QuaternaryBorder">#4A3A66</Color>

    <!-- ================= ERROR ================= -->
    <Color x:Key="Error">#E66478</Color>
    <Color x:Key="OnError">#2C0B12</Color>
    <Color x:Key="ErrorContainer">#461620</Color>
    <Color x:Key="OnErrorContainer">#F7CDD4</Color>
    <Color x:Key="ErrorBorder">#7A2734</Color>

    <!-- ================= WARNING ================= -->
    <Color x:Key="Warning">#E3A04B</Color>
    <Color x:Key="OnWarning">#2A1A05</Color>
    <Color x:Key="WarningContainer">#3D2A0E</Color>
    <Color x:Key="OnWarningContainer">#F7DEB5</Color>
    <Color x:Key="WarningBorder">#6B4A1C</Color>

    <!-- ================= SUCCESS ================= -->
    <Color x:Key="Success">#4BBD6B</Color>
    <Color x:Key="OnSuccess">#062814</Color>
    <Color x:Key="SuccessContainer">#173E25</Color>
    <Color x:Key="OnSuccessContainer">#BDE5C9</Color>
    <Color x:Key="SuccessBorder">#2A7E46</Color>

    <!-- ================= INFO ================= -->
    <Color x:Key="Info">#6BA6E0</Color>
    <Color x:Key="OnInfo">#07203A</Color>
    <Color x:Key="InfoContainer">#142F4D</Color>
    <Color x:Key="OnInfoContainer">#C2DBF7</Color>
    <Color x:Key="InfoBorder">#27517D</Color>

    <!-- ================= OUTLINE ================= -->
    <Color x:Key="Outline">#3D423D</Color>
    <Color x:Key="OutlineVariant">#272A27</Color>
    <Color x:Key="OutlineBorder">#525852</Color>

    <!-- ================= BACKGROUND ================= -->
    <Color x:Key="Background">#0C0D0C</Color>
    <Color x:Key="OnBackground">#F4F6F4</Color>
    <Color x:Key="BackgroundSecondary">#15171A</Color>

    <!-- ================= SURFACE ================= -->
    <Color x:Key="Surface">#15171A</Color>
    <Color x:Key="OnSurface">#F4F6F4</Color>
    <Color x:Key="SurfaceVariant">#22262A</Color>
    <Color x:Key="OnSurfaceVariant">#C3C7C3</Color>
    <Color x:Key="SurfaceBorder">#272A27</Color>

    <!-- ================= INVERSE ================= -->
    <Color x:Key="InverseSurface">#F4F6F4</Color>
    <Color x:Key="InverseOnSurface">#14181A</Color>
    <Color x:Key="InversePrimary">#349D57</Color>

    <!-- No SHADOW tokens — the app is shadow-free by policy (G9Controls.md → "No shadows"). -->

    <!-- ================= SURFACE CONTAINERS ================= -->
    <Color x:Key="SurfaceContainerHighest">#2A2E32</Color>
    <Color x:Key="SurfaceContainerHigh">#22262A</Color>
    <Color x:Key="SurfaceContainer">#1B1E20</Color>
    <Color x:Key="SurfaceContainerLow">#15171A</Color>
    <Color x:Key="SurfaceContainerLowest">#101113</Color>
    <Color x:Key="SurfaceBright">#2A2E32</Color>
    <Color x:Key="SurfaceDim">#0C0D0C</Color>

    <!-- ================= SCRIM & OVERLAY ================= -->
    <Color x:Key="Scrim">#CC000000</Color>
    <Color x:Key="ScrimLight">#99000000</Color>
    <Color x:Key="Overlay">#33000000</Color>
    <Color x:Key="OverlayLight">#1A000000</Color>

    <!-- ================= TEXT COLORS ================= -->
    <Color x:Key="TextPrimary">#F4F6F4</Color>
    <Color x:Key="TextSecondary">#C3C7C3</Color>
    <Color x:Key="TextTertiary">#989E98</Color>
    <Color x:Key="TextDisabled">#525852</Color>

    <!-- ================= STANDARD COLORS ================= -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="Light">#EEEEEE</Color>
    <Color x:Key="Dark">#222222</Color>

    <!-- ================= DIVIDER ================= -->
    <Color x:Key="Divider">#1F2222</Color>
    <Color x:Key="DividerStrong">#272A27</Color>

    <!-- ================= FOCUS & STATES ================= -->
    <Color x:Key="Focus">#45A664</Color>
    <Color x:Key="FocusVisible">#664BBD6B</Color>
    <Color x:Key="Disabled">#525852</Color>
    <Color x:Key="DisabledContainer">#1B1E20</Color>

    <!-- ================= CARD ================= -->
    <Color x:Key="CardBackground">#15171A</Color>
    <Color x:Key="CardBorder">#272A27</Color>
    <Color x:Key="CardElevated">#1B1E20</Color>

    <!-- ================= DEFAULT (Things locates on Background/CardBackground) ================= -->
    <Color x:Key="Default">#22262A</Color>
    <Color x:Key="OnDefault">#F4F6F4</Color>
    <Color x:Key="DefaultContainer">#2A2E32</Color>
    <Color x:Key="OnDefaultContainer">#F4F6F4</Color>
    <Color x:Key="DefaultBorder">#3D423D</Color>
    <Color x:Key="DefaultHover">#2A2E32</Color>
    <Color x:Key="DefaultPressed">#3D423D</Color>

    <!-- ================= INPUT ================= -->
    <Color x:Key="InputBackground">#15171A</Color>
    <Color x:Key="InputBorder">#3D423D</Color>
    <Color x:Key="InputBorderFocused">#45A664</Color>
    <Color x:Key="InputPlaceholder">#989E98</Color>

</ResourceDictionary>
