<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:minimalComponents="clr-namespace:G9MAUIControls.Controls"
             xmlns:theme="clr-namespace:G9MAUIControls.Theming"
             x:Class="G9MAUIControls.Controls.G9TitleWithLine"
             x:DataType="minimalComponents:G9TitleWithLine"
             x:Name="G9TitleWithLineContentView">
    <VerticalStackLayout
        Padding="{Binding Padding, Source={x:Reference G9TitleWithLineContentView}}">

        <Label
            Text="{Binding Text, Source={x:Reference G9TitleWithLineContentView}}"
            FontSize="16" />

        <BoxView
            HeightRequest="1"
            Margin="0,6,0,0"
            BackgroundColor="{theme:G9Color OutlineVariant}" />

    </VerticalStackLayout>
</ContentView>