<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:minimalComponents="clr-namespace:G9MAUIControls.Controls"
             xmlns:theme="clr-namespace:G9MAUIControls.Theming"
             x:Class="G9MAUIControls.Controls.G9VerticalIconTextButton"
             x:Name="G9VerticalIconTextButtonContentView"
             x:DataType="minimalComponents:G9VerticalIconTextButton">

    <Border BackgroundColor="{theme:G9Color SurfaceContainer}"
            Margin="0"
            StrokeShape="RoundRectangle 9"
            Stroke="{theme:G9Color SurfaceContainerHighest}">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="TapGestureRecognizer_OnTapped" />
        </Border.GestureRecognizers>

        <Grid
            InputTransparent="False"
            RowDefinitions="Auto, Auto"
            Padding="5">

            <Image Aspect="AspectFit" Grid.Row="0"
                   InputTransparent="False"
                   Source="{Binding ImageSource, Source={x:Reference G9VerticalIconTextButtonContentView}}" />

            <Label Grid.Row="1"
                   InputTransparent="False"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center"
                   TextColor="{theme:G9Color Secondary}"
                   Text="{Binding Text, Source={x:Reference G9VerticalIconTextButtonContentView}}" />

        </Grid>
    </Border>

</ContentView>